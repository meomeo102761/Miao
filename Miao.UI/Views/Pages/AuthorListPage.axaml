<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Miao.UI.Views.Pages.AuthorListPage"
             Background="{StaticResource BgMain}">

    <UserControl.Styles>
        <Style Selector="Button.pageButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.pageButton:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="#E6F7F3"/>
        </Style>
        <Style Selector="Button.pageButton:disabled">
            <Setter Property="Foreground" Value="#BBB"/>
        </Style>
        <Style Selector="Button.pageButton.active /template/ Border#Bg">
            <Setter Property="Background" Value="{StaticResource AccentJade}"/>
        </Style>
        <Style Selector="Button.pageButton.active">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Zebra striping thay cho AlternationIndex của WPF -->
        <Style Selector="Border.authorRow">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.authorRow:nth-child(2n)">
            <Setter Property="Background" Value="#F2FBF9"/>
        </Style>
        <Style Selector="Border.authorRow:pointerover">
            <Setter Property="Background" Value="#E6F7F3"/>
        </Style>
    </UserControl.Styles>

    <Grid MaxWidth="1140" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,32,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Tác giả" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#F8FAFA" CornerRadius="4" Height="38" Width="240"
                        BorderBrush="#CCC" BorderThickness="1">
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="8,0"
                             VerticalContentAlignment="Center" FontFamily="Arial" FontSize="16"
                             KeyDown="SearchBox_KeyDown"/>
                </Border>

                <Button Content="Tìm" Width="65" Height="38" Margin="8,0,0,0"
                        Classes="jadeButton" Click="OnSearchClick"/>
            </StackPanel>
        </Grid>

        <ItemsControl x:Name="AuthorsList" Grid.Row="1">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="authorRow" Cursor="Hand"
                            BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1"
                            PointerPressed="OnAuthorClick" Tag="{Binding AuthorKey}"
                            HorizontalAlignment="Stretch">

                        <Grid Margin="8,0" Height="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70*"/>
                                <ColumnDefinition Width="30*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                       FontFamily="Arial" FontSize="15.2" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0} truyện}"
                                       FontFamily="Arial" FontSize="15"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel x:Name="PageButtonsPanel" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,16,0,20"/>
    </Grid>
</UserControl>