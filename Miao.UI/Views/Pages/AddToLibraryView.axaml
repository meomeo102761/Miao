<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Miao.UI.Views.Pages.AddToLibraryView"
             xmlns:models="clr-namespace:Miao.Core.Models;assembly=Miao.Core"
             Width="360" Height="300">
    <Border Background="White" CornerRadius="8" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Thêm vào thư viện" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>

            <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="True">
                <Button Content="+ Tạo mới" Classes="jade" DockPanel.Dock="Right"
                        Width="80" Margin="8,0,0,0" Click="OnCreateNewClick"/>
                <Border BorderBrush="#CFE6E2" BorderThickness="1" CornerRadius="6">
                    <TextBox x:Name="NewLibraryNameBox" Padding="6" BorderThickness="0" FontSize="15"/>
                </Border>
            </DockPanel>

            <ScrollViewer Grid.Row="2">
                <ItemsControl x:Name="LibrariesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:CustomLibrary">
                            <Button Content="{Binding Name}" HorizontalContentAlignment="Left"
                                    Background="White" Foreground="{StaticResource TextPrimary}"
                                    BorderThickness="0" Padding="8,6" Cursor="Hand" Click="OnLibraryClick" Tag="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>