<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:reader="clr-namespace:Miao.UI.Views.Pages.Reader"
             xmlns:local="clr-namespace:Miao.UI.Views.Pages" 
             xmlns:models="clr-namespace:Miao.Core.Models;assembly=Miao.Core" x:Class="Miao.UI.Views.Pages.ReaderPage" FontFamily="Inter" FontSize="15" Loaded="OnReaderLoaded" Unloaded="OnReaderUnloaded">

    <UserControl.Resources>
        <!-- Cỡ chữ / giãn dòng / màu chữ vùng đọc — được code-behind cập nhật trực tiếp
             khi người dùng đổi trong FontPanel, nhờ đó áp dụng ngay không cần build lại UI -->
        <x:Double x:Key="ReaderLineHeightValue">22</x:Double>
        <x:Double x:Key="ReaderFontSizeValue">15</x:Double>
        <FontFamily x:Key="ReaderFontFamilyValue">Inter</FontFamily>
        <SolidColorBrush x:Key="ReaderForegroundBrush" Color="#333333"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.ReaderNavButton">
            <Setter Property="Background" Value="{StaticResource AccentJade}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
        
        <Style Selector="Button.ReaderToolButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- App.axaml có quy ước: nếu Content của Button là chuỗi text thường thì PHẢI thêm
             rule "Button.<class> TextBlock" riêng — vì có sẵn rule toàn cục
             "Button TextBlock { Foreground: White }". TextBlock ẩn mà Avalonia tự sinh ra
             cho Content="Aa" khớp đúng rule toàn cục đó, ĐÈ LÊN màu chữ set ở Button phía
             trên (dù đã set đúng {StaticResource TextPrimary}) -> chữ trắng trên nền trắng
             = vô hình. Đây là NGUYÊN NHÂN THẬT SỰ khiến nút "Aa" không hiện, không phải do
             font. Thêm lại đúng quy ước đã bị bỏ sót. -->
        <Style Selector="Button.ReaderToolButton TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
        </Style>
        <Style Selector="Button.ReaderToolButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentJadeHover}"/>
        </Style>

        <Style Selector="Path.readerIcon">
            <Setter Property="Stroke" Value="{StaticResource AccentJade}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
        </Style>
        <Style Selector="Button.ReaderToolButton:pointerover Path.readerIcon">
            <Setter Property="Stroke" Value="{StaticResource AccentJadeHover}"/>
        </Style>

        <Style Selector="Button.ReaderToolButton.active /template/ Border#Bg">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        <Style Selector="Button.ReaderToolButton.active Path.readerIcon">
            <Setter Property="Stroke" Value="{StaticResource AccentJade}"/>
        </Style>

        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>

        <Style Selector="Button.ReaderNavButton:pointerover /template/ Border#Bg, Button.ReaderToolButton:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        <Style Selector="Button.ReaderNavButton:pointerover, Button.ReaderToolButton:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
        </Style>
        
        <Style Selector="Button.ReaderLibraryButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="{StaticResource AccentJade}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        
        <Style Selector="Button.ReaderLibraryButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        
        <Style Selector="Button.ReaderLibraryButton:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
        </Style>
        
        <Style Selector="Button.ReaderActionButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
        
        <Style Selector="Button.ReaderActionButton:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        <Style Selector="Button.ReaderActionButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        <Style Selector="Button.ReaderActionButton:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AccentJade}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
        </Style>
        
        <Style Selector="Button.ReaderPrimaryButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{StaticResource AccentJade}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
        
        <Style Selector="Button.ReaderPrimaryButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        
        <Style Selector="Button.ReaderPrimaryButton:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
        </Style>
        
        <Style Selector="Button.ReaderMenuItemButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        
        <Style Selector="Button.ReaderMenuItemButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        <Style Selector="Button.ReaderMenuItemButton:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
        </Style>

        <Style Selector="TextBox.readerEditBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource ReaderForegroundBrush}"/>
            <Setter Property="LineHeight" Value="{DynamicResource ReaderLineHeightValue}"/>
            <Setter Property="FontFamily" Value="{DynamicResource ReaderFontFamilyValue}"/>
            <Setter Property="FontSize" Value="{DynamicResource ReaderFontSizeValue}"/>
        </Style>
        <Style Selector="TextBox.readerEditBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.readerEditBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.readerEditBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="TextBox.readerTitleEditBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ReaderForegroundBrush}"/>
        </Style>
        <Style Selector="TextBox.readerTitleEditBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.readerTitleEditBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.readerTitleEditBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="SelectableTextBlock.readerParagraph">
            <Setter Property="Foreground" Value="{DynamicResource ReaderForegroundBrush}"/>
            <Setter Property="LineHeight" Value="{DynamicResource ReaderLineHeightValue}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Cursor" Value="IBeam"/>
        </Style>
        <Style Selector="SelectableTextBlock.readerParagraph Run">
            <Setter Property="Foreground" Value="{DynamicResource ReaderForegroundBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="ReaderRoot" Background="#F7F5F0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="ReaderTopBar" Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="‹ " FontSize="15" Foreground="{StaticResource AccentJade}" Cursor="Hand" PointerPressed="OnNovelTitleClick"/>
                        <TextBlock x:Name="NovelTitleText" FontSize="15" Foreground="{StaticResource AccentJade}" Cursor="Hand" PointerPressed="OnNovelTitleClick" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="ChapterTitleText" FontSize="18" FontWeight="Bold" Foreground="#333333" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="EditButton" Classes="ReaderToolButton" Click="OnToggleEdit" IsVisible="True">
                        <Path Classes="readerIcon" Data="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
                    </Button>
                    <Button x:Name="InsertImageButton" Classes="ReaderToolButton" Click="OnInsertImageClick" IsVisible="False">
                        <Path Classes="readerIcon" Data="M21 3H3a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z M8.5 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z M21 15l-5-5L5 21"/>
                    </Button>
                    <Button x:Name="BoldButton" Content="B" Classes="ReaderToolButton" FontWeight="Bold" Focusable="False" Click="OnBoldClick" IsVisible="False"/>
                    <Button x:Name="ItalicButton" Content="I" Classes="ReaderToolButton" FontStyle="Italic" Focusable="False" Click="OnItalicClick" IsVisible="False"/>
                    <Button x:Name="UnderlineButton" Content="U" Classes="ReaderToolButton" Focusable="False" Click="OnUnderlineClick" IsVisible="False"/>
                    <Button x:Name="StrikeButton" Content="S" Classes="ReaderToolButton" Focusable="False" Click="OnStrikeClick" IsVisible="False"/>
                    <Button x:Name="FontPanelButton" Content="Aa" Classes="ReaderToolButton" Click="OnToggleFontPanel" IsVisible="True"/>
                    <Button x:Name="FavoriteButton" Classes="ReaderToolButton" Click="OnToggleFavorite" IsVisible="True">
                        <Path x:Name="FavoriteIconPath" Classes="readerIcon" Data="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </Button>
                    <Button x:Name="PinButton" Classes="ReaderToolButton" Click="OnTogglePin" IsVisible="True">
                        <Path x:Name="PinIconPath" Classes="readerIcon" Data="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                    </Button>
                    <Button x:Name="AddLibraryButton" Content="＋" Classes="ReaderLibraryButton" Click="OnAddToLibraryReaderClick" IsVisible="True"/>
                    <Button x:Name="EditTargetOriginalButton" Content="Gốc" Classes="ReaderToolButton" Width="52" Margin="8,0,2,0" Click="OnSetEditTargetOriginal"/>
                    <Button x:Name="EditTargetTranslatedButton" Content="Dịch" Classes="ReaderToolButton" Width="52" Click="OnSetEditTargetTranslated"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ReaderScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,35,20,30" MaxWidth="1140">

                    <Border x:Name="ReadingCard" Background="#FFFDF8" BorderBrush="#E8E3D9" BorderThickness="1" Padding="70,55,70,65">
                        <StackPanel>
                            <TextBlock x:Name="ChapterHeadingText" HorizontalAlignment="Center" FontSize="25" FontWeight="Bold"
                                    TextWrapping="Wrap" Margin="0,0,0,36" Foreground="{DynamicResource ReaderForegroundBrush}"/>
                            <TextBox x:Name="ChapterTitleEditBox" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,36"
                                    Classes="readerTitleEditBox" IsVisible="False"/>

                            <ItemsControl x:Name="ReadBlocksList"/>

                            <ItemsControl x:Name="EditBlocksList" IsVisible="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="local:ReaderDisplayGroup">
                                        <Grid Margin="0,0,0,4">
                                            <TextBox Text="{Binding Text, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True"
                                                    Classes="readerEditBox" GotFocus="OnEditGroupTextBoxFocused"
                                                    KeyDown="OnEditTextBoxPasteCheck"
                                                    ContextRequested="OnEditTextBoxContextRequested"
                                                    IsVisible="{Binding !IsImage}">
                                                <TextBox.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Thêm tên" Click="OnEditContextAddNameClick"/>
                                                    </ContextMenu>
                                                </TextBox.ContextMenu>
                                            </TextBox>
                                            <Grid IsVisible="{Binding IsImage}" HorizontalAlignment="Center" Margin="0,6,0,16">
                                                <Image Source="{Binding ImagePath, Converter={StaticResource CoverImageConverter}}" Stretch="Uniform" MaxWidth="640"/>
                                                <Button Classes="ReaderToolButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Click="OnRemoveImageGroupClick" Tag="{Binding}">
                                                    <Path Classes="readerIcon" Data="M18 6L6 18 M6 6l12 12" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="TranslatingText" IsVisible="False" Foreground="{DynamicResource ReaderForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Popup x:Name="FontPanelPopup" PlacementTarget="{Binding #FontPanelButton}" Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True">
                <Border Width="260" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Font"/>
                        <ComboBox x:Name="FontFamilyBox" HorizontalAlignment="Stretch" SelectionChanged="OnFontChanged">
                            <ComboBoxItem Content="Arial"/>
                            <ComboBoxItem Content="Times New Roman"/>
                            <ComboBoxItem Content="Georgia"/>
                            <ComboBoxItem Content="Segoe UI"/>
                        </ComboBox>

                        <TextBlock Text="Cỡ chữ" Margin="0,10,0,0"/>
                        <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="26" ValueChanged="OnFontSizeChanged"/>
                        <TextBlock x:Name="FontSizeValueText"/>

                        <TextBlock Text="Giãn dòng" Margin="0,10,0,0"/>
                        <Slider x:Name="LineHeightSlider" Minimum="1.0" Maximum="2.2" ValueChanged="OnLineHeightChanged"/>
                        <TextBlock x:Name="LineHeightValueText"/>

                        <TextBlock Text="Nền đọc" Margin="0,10,0,0"/>
                        <ComboBox x:Name="ReaderBackgroundBox" HorizontalAlignment="Stretch" SelectionChanged="OnReaderBackgroundChanged">
                            <ComboBoxItem Content="Trắng" Tag="#FFFFFF"/>
                            <ComboBoxItem Content="Nâu nhạt" Tag="#FFFDF8"/>
                            <ComboBoxItem Content="Đen" Tag="#171717"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Border x:Name="ReaderBottomBar" Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="22,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="PrevButton" Content="←  Chương trước" Classes="ReaderNavButton" Click="OnPrevClick"/>
                <ComboBox x:Name="ChapterComboBox" Width="300" Margin="12,0" SelectionChanged="OnChapterSelected">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="NextButton" Content="Chương sau  →" Classes="ReaderNavButton" Click="OnNextClick"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
