<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:reader="clr-namespace:Miao.UI.Views.Pages.Reader"
             xmlns:local="clr-namespace:Miao.UI.Views.Pages" 
             xmlns:models="clr-namespace:Miao.Core.Models;assembly=Miao.Core" x:Class="Miao.UI.Views.Pages.ReaderPage" FontFamily="Arial" FontSize="15" Loaded="OnReaderLoaded" Unloaded="OnReaderUnloaded">

    <UserControl.Resources>
        <!-- Cỡ chữ / giãn dòng / màu chữ vùng đọc — được code-behind cập nhật trực tiếp
             khi người dùng đổi trong FontPanel, nhờ đó áp dụng ngay không cần build lại UI -->
        <x:Double x:Key="ReaderLineHeightValue">22</x:Double>
        <SolidColorBrush x:Key="ReaderForegroundBrush" Color="#333333"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.ReaderNavButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        
        <Style Selector="Button.ReaderToolButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Trước đây hover chỉ đổi màu nền của ContentPresenter (hình vuông NHỎ bên trong,
             không bo góc) trong khi viền Border#Bg (hình vuông NGOÀI) vẫn trong suốt -> tạo
             cảm giác 2 lớp hình vuông lồng nhau. Giờ đổi thẳng nền của Border#Bg (đã bo góc
             theo CornerRadius) để có 1 khối hover đồng nhất, màu xanh nhạt (AccentJadeSoft). -->
        <Style Selector="Button.ReaderNavButton:pointerover /template/ Border#Bg, Button.ReaderToolButton:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        <Style Selector="Button.ReaderNavButton:pointerover, Button.ReaderToolButton:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
        </Style>
        
        <Style Selector="Button.ReaderLibraryButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="{StaticResource AccentJade}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        
        <Style Selector="Button.ReaderLibraryButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        
        <Style Selector="Button.ReaderLibraryButton:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
        </Style>
        
        <!-- Nền xám (#F0F0F0) đổi thành xanh nhạt cho đồng bộ theme -->
        <Style Selector="Button.ReaderActionButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
        
        <Style Selector="Button.ReaderActionButton:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        <Style Selector="Button.ReaderActionButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        <Style Selector="Button.ReaderActionButton:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AccentJade}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
        </Style>
        
        <Style Selector="Button.ReaderPrimaryButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{StaticResource AccentJade}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
        
        <Style Selector="Button.ReaderPrimaryButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        
        <Style Selector="Button.ReaderPrimaryButton:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
        </Style>
        
        <!-- Nút trong menu "Thêm vào thư viện": nền trắng, viền xanh nhạt, hover xanh nhạt (bỏ #F0F0F0 xám) -->
        <Style Selector="Button.ReaderMenuItemButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        
        <Style Selector="Button.ReaderMenuItemButton:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>
        <Style Selector="Button.ReaderMenuItemButton:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AccentJade}"/>
        </Style>

        <!-- Bỏ khung viền quanh từng dòng khi ở chế độ Sửa: chỉ còn 1 vùng nhập liền mạch -->
        <Style Selector="TextBox.readerEditBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource ReaderForegroundBrush}"/>
            <Setter Property="LineHeight" Value="{DynamicResource ReaderLineHeightValue}"/>
        </Style>
        <Style Selector="TextBox.readerEditBox:focus">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>

        <!-- Đoạn văn khi đọc (liền mạch nhiều dòng như Word, không bị ngắt theo từng khối) -->
        <Style Selector="SelectableTextBlock.readerParagraph">
            <Setter Property="Foreground" Value="{DynamicResource ReaderForegroundBrush}"/>
            <Setter Property="LineHeight" Value="{DynamicResource ReaderLineHeightValue}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Tên nhân vật được nhận diện: gạch chân nhẹ để gợi ý có thể bấm vào (double-click) -->
        <Style Selector="SelectableTextBlock.readerParagraph:pointerover">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="ReaderRoot" Background="#F7F5F0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="ReaderTopBar" Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="‹ " FontSize="15" Foreground="{StaticResource AccentJade}" Cursor="Hand" PointerPressed="OnNovelTitleClick"/>
                        <TextBlock x:Name="NovelTitleText" FontSize="15" Foreground="{StaticResource AccentJade}" Cursor="Hand" PointerPressed="OnNovelTitleClick" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="ChapterTitleText" FontSize="18" FontWeight="Bold" Foreground="#333333" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="EditButton" Content="✏" Classes="ReaderToolButton" Click="OnToggleEdit" IsVisible="True"/>
                    <Button x:Name="InsertImageButton" Content="🖼" Classes="ReaderToolButton" Click="OnInsertImageClick" IsVisible="False"/>
                    <Button x:Name="FontPanelButton" Content="Aa" Classes="ReaderToolButton" Click="OnToggleFontPanel" IsVisible="True"/>
                    <Button x:Name="FavoriteButton" Content="☆" Classes="ReaderToolButton" Click="OnToggleFavorite" IsVisible="True"/>
                    <Button x:Name="PinButton" Content="📌" Classes="ReaderToolButton" Click="OnTogglePin" IsVisible="True"/>
                    <Button x:Name="AddLibraryButton" Content="＋" Classes="ReaderLibraryButton" Click="OnAddToLibraryReaderClick" IsVisible="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ReaderScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,35,20,30" MaxWidth="1140">

                    <Border x:Name="ReadingCard" Background="#FFFDF8" BorderBrush="#E8E3D9" BorderThickness="1" Padding="70,55,70,65">
                        <StackPanel>
                            <TextBlock x:Name="ChapterHeadingText" HorizontalAlignment="Center" FontSize="25" FontWeight="Bold"
                                       TextWrapping="Wrap" Margin="0,0,0,36" Foreground="{DynamicResource ReaderForegroundBrush}"/>

                            <!-- CHẾ ĐỘ ĐỌC: các dòng liên tiếp (không phải ảnh) được gộp lại thành 1
                                 SelectableTextBlock duy nhất -> bôi đen/chọn văn bản liền mạch nhiều
                                 đoạn như Word, thay vì bị khoá cứng theo từng dòng riêng lẻ. -->
                            <ItemsControl x:Name="ReadBlocksList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="local:ReaderDisplayGroup">
                                        <Grid Margin="0,0,0,4">
                                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes="readerParagraph"
                                                                  IsVisible="{Binding !IsImage}"
                                                                  ContextRequested="OnTextBlockContextRequested"
                                                                  DoubleTapped="OnParagraphDoubleTapped"
                                                                  Tag="{Binding}">
                                                <SelectableTextBlock.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Thêm" Click="OnContextAddStyledClick"/>
                                                        <MenuItem Header="Thêm nhân vật" Click="OnContextAddCharacterClick"/>
                                                        <MenuItem Header="Copy" Click="OnContextCopyClick"/>
                                                    </ContextMenu>
                                                </SelectableTextBlock.ContextMenu>
                                            </SelectableTextBlock>

                                            <Image Source="{Binding ImagePath, Converter={StaticResource CoverImageConverter}}"
                                                   Stretch="Uniform" MaxWidth="640" Margin="0,10,0,24"
                                                   IsVisible="{Binding IsImage}" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- CHẾ ĐỘ SỬA: giữ nguyên theo từng dòng (bắt buộc, để khớp với logic
                                 dịch lại theo diff dòng-gốc trong SaveEditAsync) nhưng bỏ khung viền
                                 quanh từng ô để nhìn liền mạch hơn. -->
                            <ItemsControl x:Name="EditBlocksList" IsVisible="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="reader:ReaderBlockViewModel">
                                        <Grid>
                                            <TextBox Text="{Binding Text}" TextWrapping="Wrap" AcceptsReturn="True"
                                                     Classes="readerEditBox" GotFocus="OnBlockTextBoxFocused"
                                                     KeyDown="OnEditTextBoxPasteCheck"
                                                     IsVisible="{Binding !IsImage}"/>
                                            <Grid IsVisible="{Binding IsImage}" HorizontalAlignment="Center" Margin="0,6,0,16">
                                                <Image Source="{Binding ImagePath, Converter={StaticResource CoverImageConverter}}" Stretch="Uniform" MaxWidth="640"/>
                                                <Button Content="✕" Classes="ReaderToolButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Click="OnRemoveImageBlockClick" Tag="{Binding}"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="TranslatingText" IsVisible="False" Foreground="{DynamicResource ReaderForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="FontPanel" Width="260" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="10" Padding="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,0,0" IsVisible="False">
                <StackPanel Spacing="6">
                    <TextBlock Text="Font"/>
                    <ComboBox x:Name="FontFamilyBox" HorizontalAlignment="Stretch" SelectionChanged="OnFontChanged">
                        <ComboBoxItem Content="Arial"/>
                        <ComboBoxItem Content="Times New Roman"/>
                        <ComboBoxItem Content="Georgia"/>
                        <ComboBoxItem Content="Segoe UI"/>
                    </ComboBox>

                    <TextBlock Text="Cỡ chữ" Margin="0,10,0,0"/>
                    <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="26" ValueChanged="OnFontSizeChanged"/>
                    <TextBlock x:Name="FontSizeValueText"/>

                    <TextBlock Text="Giãn dòng" Margin="0,10,0,0"/>
                    <Slider x:Name="LineHeightSlider" Minimum="1.0" Maximum="2.2" ValueChanged="OnLineHeightChanged"/>
                    <TextBlock x:Name="LineHeightValueText"/>

                    <TextBlock Text="Nền đọc" Margin="0,10,0,0"/>
                    <ComboBox x:Name="ReaderBackgroundBox" HorizontalAlignment="Stretch" SelectionChanged="OnReaderBackgroundChanged">
                        <ComboBoxItem Content="Trắng" Tag="#FFFFFF"/>
                        <ComboBoxItem Content="Nâu nhạt" Tag="#FFFDF8"/>
                        <ComboBoxItem Content="Đen" Tag="#171717"/>
                    </ComboBox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Thanh chuyển chương: ghim cố định ở đáy MÀN HÌNH, full-width giống thanh trên
             cùng, không di chuyển khi cuộn nội dung lên/xuống. -->
        <Border x:Name="ReaderBottomBar" Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PrevButton" Grid.Column="0" Content="←  Chương trước" Classes="ReaderNavButton" Click="OnPrevClick"/>
                <ComboBox x:Name="ChapterComboBox" Grid.Column="1" Width="300" SelectionChanged="OnChapterSelected">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayTitle}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="NextButton" Grid.Column="2" Content="Chương sau  →" Classes="ReaderNavButton" Click="OnNextClick"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
