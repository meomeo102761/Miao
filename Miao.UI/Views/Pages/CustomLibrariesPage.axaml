<local:ConfirmablePage xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Miao.UI.Views.Pages"
      x:Class="Miao.UI.Views.Pages.CustomLibrariesPage"
      Background="{StaticResource BgMain}">

    <UserControl.Styles>
        <Style Selector="Button.pillAction">
            <Setter Property="Background" Value="#EFF4F3"/>
            <Setter Property="Foreground" Value="#01A4B9"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.pillAction:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="#01A4B9"/>
        </Style>
        <Style Selector="Button.pillAction:pointerover">
            <Setter Property="Foreground" Value="#EFF4F3"/>
        </Style>

        <Style Selector="Button.dialogPrimary">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style Selector="Button.dialogDanger">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#E4574C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="18">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.dialogSecondary">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1140" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="500"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Thư viện riêng" Style="{StaticResource PageTitle}"/>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#BBBBBB" BorderThickness="1" CornerRadius="5" Height="30"
                    Width="280" HorizontalAlignment="Left">
                <TextBox x:Name="NewNameBox" Padding="11,0" BorderThickness="0" VerticalContentAlignment="Center"
                         FontFamily="Arial" FontSize="15" Watermark="Tên bộ sưu tập mới"/>
            </Border>

            <Button Grid.Column="1" Content="+ Tạo mới" Width="90" Margin="8,0,0,0"
                    Style="{StaticResource JadeButton}" Click="OnCreateClick"/>

            <Button x:Name="EditModeButton" Grid.Column="3" Content="Sửa" Width="70"
                    Style="{StaticResource JadeButton}" Click="OnEditModeClick"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="LibrariesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                CornerRadius="6" Padding="22,10,27,5" Margin="0,0,0,8"
                                DragDrop.AllowDrop="True" DragDrop.Drop="OnLibraryItemDrop">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="DragHandleIcon" Grid.Column="0" Text="⋮⋮" FontSize="18"
                                           Foreground="#999999" Cursor="SizeAll" IsVisible="False"
                                           VerticalAlignment="Center" Margin="0,0,14,0"
                                           PointerPressed="OnDragHandlePointerPressed"
                                           PointerMoved="OnDragHandlePointerMoved"/>

                                <StackPanel Grid.Column="1" Cursor="Hand" PointerPressed="OnLibraryClick" Tag="{Binding}">
                                    <TextBlock Text="{Binding Name}" FontFamily="Roboto" FontSize="17.6" Foreground="#555555"/>
                                    <TextBlock Text="{Binding Count, StringFormat={}{0} truyện}" FontFamily="Roboto"
                                               FontSize="14.4" Foreground="#999999" Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel x:Name="LibraryEditControls" Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center" IsVisible="False">
                                    <Button Content="✎" ToolTip.Tip="Sửa" Classes="pillAction"
                                            Click="OnRenameClick" Tag="{Binding}"/>
                                    <Button Content="✕" ToolTip.Tip="Xóa" Classes="pillAction"
                                            Click="OnDeleteClick" Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border x:Name="RenameCard" IsVisible="False" Background="White" CornerRadius="12" Width="360" Padding="24">
            <StackPanel>
                <TextBlock Text="Đổi tên bộ sưu tập" FontFamily="Arial" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>
                <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="6" Height="36" Padding="10,0" Margin="0,0,0,18">
                    <TextBox x:Name="RenameBox" FontSize="15" BorderThickness="0" VerticalContentAlignment="Center"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Lưu" Classes="dialogPrimary" Style="{StaticResource JadeButton}" Click="OnRenameSaveClick"/>
                    <Button Content="Hủy" Classes="dialogSecondary" Click="OnRenameCancelClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="ConfirmCard" IsVisible="False" Background="White" CornerRadius="12" Width="360" Padding="24">
            <StackPanel>
                <TextBlock x:Name="ConfirmMessageText" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Xóa" Classes="dialogDanger" Click="OnConfirmYesClick"/>
                    <Button Content="Hủy" Classes="dialogSecondary" Click="OnConfirmNoClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</local:ConfirmablePage>