<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Miao.UI.Views.Pages.WorkspacePage"
             Background="{StaticResource BgMain}"
             FontFamily="Segoe UI"
             FontSize="15">

    <UserControl.Resources>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="NovelActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>
        <Style Selector="Button.novelAction:pointerover">
            <Setter Property="Background" Value="#F0F0F0"/>
        </Style>

        <Style x:Key="NovelPrimaryButton" TargetType="Button" BasedOn="{StaticResource NovelActionButton}">
            <Setter Property="Background" Value="{StaticResource AccentJade}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="NovelDangerButton" TargetType="Button" BasedOn="{StaticResource NovelActionButton}">
            <Setter Property="Background" Value="#E0503A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="PagerButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
        </Style>

        <!-- Thay cho DataTrigger IsCurrent của WPF: gán class "current" động theo binding -->
        <Style Selector="Button.pagerNumber.current">
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer>
    <StackPanel Margin="20" MaxWidth="1000">

        <StackPanel Orientation="Horizontal" Cursor="Hand" HorizontalAlignment="Left"
                    PointerPressed="OnBackToNovelClick">
            <TextBlock Text="‹ " FontSize="20" Foreground="{StaticResource AccentJade}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" Foreground="{StaticResource AccentJade}"/>
        </StackPanel>

        <TextBlock Text="Không gian làm việc — bấm vào chương để sửa trực tiếp"
                   FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="✚ Tạo quyển" Style="{StaticResource NovelActionButton}" Classes="novelAction" Click="OnCreateVolumeClick"/>
            <Button x:Name="BulkDeleteButton" Style="{StaticResource NovelDangerButton}"
                    Click="OnBulkDeleteChaptersClick" IsVisible="False"/>
        </StackPanel>

        <ItemsControl x:Name="VolumesList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Expander Margin="0,0,0,12" IsExpanded="True">

                        <Expander.Header>
                            <Grid Margin="0,2,8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding HeaderText}"
                                           FontSize="15" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            IsVisible="{Binding CanManage}">
                                    <Button Content="✎" Style="{StaticResource PagerButton}" ToolTip.Tip="Sửa quyển"
                                            Click="OnEditVolumeClick" Tag="{Binding}"/>
                                    <Button Content="🗑" Style="{StaticResource PagerButton}" ToolTip.Tip="Xóa quyển"
                                            Click="OnDeleteVolumeClick" Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Expander.Header>

                        <StackPanel Margin="6,6,0,0">

                            <ItemsControl ItemsSource="{Binding PagedChapters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="42" Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    IsCheckedChanged="OnChapterCheckToggled"
                                                    Tag="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                            <TextBlock Grid.Column="1" Text="{Binding Number}"
                                                    Foreground="#333" FontWeight="Bold" FontSize="15"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <Border Grid.Column="2" Background="White" CornerRadius="7" Padding="10,5"
                                                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <DockPanel Grid.Column="0" Cursor="Hand"
                                                            PointerPressed="OnChapterClick" Tag="{Binding}">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                                                                FontSize="12" Foreground="#999"
                                                                VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        <TextBlock Text="{Binding Title}" Foreground="#333" FontSize="15"
                                                                TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding GlobalIndex, StringFormat=' · #{0} toàn truyện'}"
                                                                FontSize="12" Foreground="{StaticResource TextMuted}"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding ShowGlobalIndex}"/>
                                                    </DockPanel>

                                                    <Button Grid.Column="1" Content="✎" Style="{StaticResource PagerButton}"
                                                            ToolTip.Tip="Sửa tên chương" Click="OnEditChapterClick" Tag="{Binding}"/>
                                                    <Button Grid.Column="2" Content="✕" Style="{StaticResource PagerButton}"
                                                            ToolTip.Tip="Xóa chương" Click="OnDeleteChapterClick" Tag="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,3"
                                        IsVisible="{Binding ShowPager}">
                                <Button Content="‹" Style="{StaticResource PagerButton}"
                                        Click="OnGroupPrevPageClick" Tag="{Binding}"/>

                                <ItemsControl ItemsSource="{Binding PagerItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="…" FontSize="12" Margin="4,0"
                                                           Foreground="{StaticResource TextMuted}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsEllipsis}"/>
                                                <Button Content="{Binding Label}" Style="{StaticResource PagerButton}"
                                                        Classes="pagerNumber" Classes.current="{Binding IsCurrent}"
                                                        Click="OnGroupPageClick" Tag="{Binding}"
                                                        IsVisible="{Binding IsPage}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="›" Style="{StaticResource PagerButton}"
                                        Click="OnGroupNextPageClick" Tag="{Binding}"/>
                            </StackPanel>

                        </StackPanel>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="CreateVolumeCard" IsVisible="False" Background="White" CornerRadius="12" Width="400" Padding="20">
            <StackPanel>
                <TextBlock Text="Tạo quyển mới" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,12"/>

                <TextBlock Text="Tên quyển:" Foreground="#333" FontSize="15" Margin="0,0,0,4"/>
                <TextBox x:Name="NewVolumeNameBox" FontSize="15" Height="38" Padding="8,0" VerticalContentAlignment="Center"
                         Margin="0,0,0,12" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"/>

                <TextBlock Text="Chỉ chọn được trong các chương đang &quot;Chưa phân quyển&quot; (tránh trùng số chương giữa các quyển)."
                           FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="RangeModeRadio" Content="Theo phạm vi chương" GroupName="VolumeAssignMode"
                                 Foreground="#333" FontSize="15" IsChecked="True" IsCheckedChanged="OnAssignModeChanged" Margin="0,0,14,0"/>
                    <RadioButton x:Name="ManualModeRadio" Content="Chọn từng chương" GroupName="VolumeAssignMode"
                                 Foreground="#333" FontSize="15" IsCheckedChanged="OnAssignModeChanged"/>
                </StackPanel>

                <StackPanel x:Name="RangePanel">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Từ chương:" Foreground="#333" FontSize="15" Margin="0,0,0,4"/>
                            <TextBox x:Name="RangeFromBox" Width="90" Height="38" Padding="8,0" FontSize="15"
                                     VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Đến chương:" Foreground="#333" FontSize="15" Margin="0,0,0,4"/>
                            <TextBox x:Name="RangeToBox" Width="90" Height="38" Padding="8,0" FontSize="15"
                                     VerticalContentAlignment="Center" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ManualPanel" IsVisible="False">
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <ItemsControl x:Name="ManualPickList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Foreground="#333" FontSize="15" Margin="0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <TextBlock x:Name="CreateVolumeErrorText" Foreground="#D1621E" FontSize="12" Margin="0,0,0,8"
                           TextWrapping="Wrap" IsVisible="False"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Tạo quyển" Width="105" Style="{StaticResource NovelPrimaryButton}" Click="OnCreateVolumeSaveClick"/>
                    <Button Content="Hủy" Width="85" Style="{StaticResource NovelActionButton}" Click="OnCreateVolumeCancelClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="EditVolumeCard" IsVisible="False" Background="White" CornerRadius="12" Width="360" Padding="20">
            <StackPanel>
                <TextBlock Text="Sửa quyển" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,12"/>
                <TextBlock Text="Tên quyển:" Foreground="#333" FontSize="15" Margin="0,0,0,4"/>
                <TextBox x:Name="EditVolumeNameBox" FontSize="15" Height="38" Padding="8,0" VerticalContentAlignment="Center"
                         Margin="0,0,0,14" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Lưu" Width="85" Style="{StaticResource NovelPrimaryButton}" Click="OnEditVolumeSaveClick"/>
                    <Button Content="Xóa quyển" Width="95" Style="{StaticResource NovelActionButton}" Click="OnEditVolumeDeleteClick"/>
                    <Button Content="Hủy" Width="85" Style="{StaticResource NovelActionButton}" Click="OnEditVolumeCancelClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="EditChapterCard" IsVisible="False" Background="White" CornerRadius="12" Width="360" Padding="20">
            <StackPanel>
                <TextBlock Text="Sửa tên chương" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,12"/>
                <TextBlock x:Name="EditChapterNumberText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="EditChapterTitleBox" FontSize="15" Height="38" Padding="8,0" VerticalContentAlignment="Center"
                         Margin="0,0,0,14" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Lưu" Width="85" Style="{StaticResource NovelPrimaryButton}" Click="OnEditChapterSaveClick"/>
                    <Button Content="Hủy" Width="85" Style="{StaticResource NovelActionButton}" Click="OnEditChapterCancelClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="ConfirmCard" IsVisible="False" Background="White" CornerRadius="12" Width="360" Padding="20">
            <StackPanel>
                <TextBlock Text="Xác nhận" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,8"/>
                <TextBlock x:Name="ConfirmMessageText" FontSize="13" Foreground="#444" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Xác nhận" Width="95" Style="{StaticResource NovelDangerButton}" Click="OnConfirmYesClick"/>
                    <Button Content="Hủy" Width="85" Style="{StaticResource NovelActionButton}" Click="OnConfirmCancelClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </StackPanel>
    </ScrollViewer>
</UserControl>