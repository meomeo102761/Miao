<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Miao.UI.Views.Pages"
             x:Class="Miao.UI.Views.Pages.ChapterEditorPage"
             Background="{StaticResource BgMain}"
             FontFamily="Inter" FontSize="15">

    <UserControl.Styles>

        <Style Selector="Button.EditorToolButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.EditorToolButton TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
        </Style>
        <Style Selector="Button.EditorToolButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>

        <Style Selector="Button.PublishToggleButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentJade}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="17"/>
        </Style>
        <Style Selector="Button.PublishToggleButton TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentJade}"/>
        </Style>
        <Style Selector="Button.PublishToggleButton.published">
            <Setter Property="Background" Value="{StaticResource AccentJade}"/>
        </Style>
        <Style Selector="Button.PublishToggleButton.published TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.PublishToggleButton:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>

        <Style Selector="Button.NovelDropdownArea">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.NovelDropdownArea:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.ChapterListItemButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.ChapterListItemButton TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.ChapterListItemButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentJadeSoft}"/>
        </Style>

        <Style Selector="TextBox.plainTitleBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style Selector="TextBox.plainTitleBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.plainTitleBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <Style Selector="TextBox.plainContentBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style Selector="TextBox.plainContentBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.plainContentBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <Border x:Name="EditorTopBar" Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1" Padding="22,10">
            <Grid ColumnDefinitions="*,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="‹" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentJade}"
                               Cursor="Hand" PointerPressed="OnBackClick" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Button x:Name="NovelDropdownButton" Classes="NovelDropdownArea" Click="OnToggleChapterDropdown">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="NovelDropdownTitleText" Text="Tên truyện" FontSize="15"
                                           Foreground="{StaticResource AccentJade}" Cursor="Hand" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text=" ▾" FontSize="13" Foreground="{StaticResource AccentJade}"/>
                            </StackPanel>
                            <TextBlock x:Name="ChapterTitleDisplayText" FontSize="18" FontWeight="Bold" Foreground="#333333"
                                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Button>

                    <Popup x:Name="ChapterDropdownPopup" PlacementTarget="{Binding #EditorTopBar}"
                            Placement="BottomEdgeAlignedLeft" HorizontalOffset="22" IsLightDismissEnabled="True">
                        <Border Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                CornerRadius="8" Width="280" Padding="4">
                            <StackPanel Background="White">
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ChapterDropdownList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:ChapterRowViewModel">
                                                <Button Content="{Binding DisplayTitle}" Classes="ChapterListItemButton"
                                                        Click="OnChapterDropdownItemClick" Tag="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Separator Margin="4,3"/>
                                <Button Content="+ Chương Mới" Classes="ChapterListItemButton"
                                        Click="OnAddChapterFromDropdownClick"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
                    <TextBlock x:Name="WordCountText" Text="0 từ" FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SaveStatusText" Text="Đã lưu" FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <Button x:Name="PublishToggleButton" Classes="PublishToggleButton" Content="Đăng tải" Click="OnTogglePublishClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="EditorScrollHost" RowDefinitions="Auto,*">
            <ScrollViewer Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" Background="White">
                <StackPanel Margin="20,30,20,30" Background="White">
                    <Border x:Name="EditorContentGrid" HorizontalAlignment="Center" Background="White">
                        <StackPanel>
                            <TextBox x:Name="ChapterTitleBox" Watermark="Tên chương..." Padding="0,4,0,14"
                                    Classes="plainTitleBox" FocusAdorner="{x:Null}"
                                    FontFamily="Inter" FontSize="20" FontWeight="Bold"
                                    TextAlignment="Center" HorizontalContentAlignment="Center"
                                    TextChanged="OnContentChanged"/>

                            <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0" Margin="0,0,0,20"/>

                            <TextBox x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap"
                                    Classes="plainContentBox" Padding="0" FontFamily="Inter" FontSize="16"
                                    FocusAdorner="{x:Null}"
                                    VerticalContentAlignment="Top" MinHeight="500"
                                    ContextFlyout="{x:Null}"
                                    TextChanged="OnContentChanged"
                                    PointerPressed="OnContentBoxPointerPressed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>