<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Miao.UI.Views.MainView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Thanh menu trên -->
        <Border Grid.Row="0" Background="{StaticResource AccentJade}">
            <DockPanel LastChildFill="False">

                <TextBlock Text="₍^. .^₎Ⳋ Miao"
                           DockPanel.Dock="Left"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Cursor="Hand"
                           VerticalAlignment="Center"
                           Margin="24,0,30,0"
                           PointerPressed="OnLogoClick"/>

                <!-- Nút menu, chỉ hiện khi màn hình hẹp -->
                <Button x:Name="MenuToggleButton"
                        Content="🐾 Menu"
                        DockPanel.Dock="Right"
                        Classes="TopNavButton"
                        Width="110"
                        IsVisible="False"
                        Click="OnMenuToggleClick"/>

                <!-- Menu ngang đầy đủ -->
                <StackPanel x:Name="NavButtonsPanel"
                            Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Top">

                    <Button Content="Tìm truyện" Classes="TopNavButton" Click="GoSearch"/>

                    <Grid x:Name="DownloadMenuArea"
                          Width="105" Height="60"
                          PointerEntered="OnDownloadMenuEnter"
                          PointerExited="OnDownloadMenuLeave">

                        <Button Content="Tải truyện" Width="105" Height="60" Classes="TopNavButton"/>

                        <Popup x:Name="DownloadPopup"
                               PlacementTarget="{Binding #DownloadMenuArea}"
                               Placement="Bottom">

                            <Border Width="105"
                                    Background="#1C8F76"
                                    PointerEntered="OnDownloadMenuEnter"
                                    PointerExited="OnDownloadMenuLeave">
                                <StackPanel>
                                    <Button Content="Bằng link" Classes="DownloadSubButton" Click="GoDownloadLink"/>
                                    <Button Content="Bằng file" Classes="DownloadSubButton" Click="GoDownloadFile"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Content="Thư viện" Classes="TopNavButton" Click="GoCustomLibraries"/>
                    <Button Content="Viết truyện" Classes="TopNavButton" Click="GoWriteNovel"/>
                    <Button Content="Bookmarks" Classes="TopNavButton" Click="GoBookmarks"/>
                    <Button Content="Nhân vật" Classes="TopNavButton" Click="GoCharacters"/>
                    <Button Content="Tác giả" Classes="TopNavButton" Click="GoAuthorList"/>
                    <Button Content="Bộ tên" Classes="TopNavButton" Click="GoGlossary"/>
                    <Button Content="Cài đặt" Classes="TopNavButton" Click="GoSettings"/>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Popup menu dạng danh sách khi màn hình hẹp -->
        <Popup x:Name="MobileNavPopup"
               PlacementTarget="{Binding #MenuToggleButton}"
               Placement="Bottom"
               HorizontalOffset="-90"
               IsLightDismissEnabled="True">
            <Border Width="200"
                    Background="{StaticResource AccentJade}"
                    CornerRadius="0,0,8,8"
                    BoxShadow="0 2 14 0 #40000000">
                <StackPanel>
                    <Button Content="🔍 Tìm truyện" Classes="MobileNavItem" Click="OnMobileGoSearch"/>
                    <Button Content="⬇ Tải truyện (link)" Classes="MobileNavItem" Click="OnMobileGoDownloadLink"/>
                    <Button Content="⬇ Tải truyện (file)" Classes="MobileNavItem" Click="OnMobileGoDownloadFile"/>
                    <Button Content="📚 Thư viện" Classes="MobileNavItem" Click="OnMobileGoCustomLibraries"/>
                    <Button Content="✍ Viết truyện" Classes="MobileNavItem" Click="OnMobileGoWriteNovel"/>
                    <Button Content="🔖 Bookmarks" Classes="MobileNavItem" Click="OnMobileGoBookmarks"/>
                    <Button Content="👤 Nhân vật" Classes="MobileNavItem" Click="OnMobileGoCharacters"/>
                    <Button Content="🐈 Tác giả" Classes="MobileNavItem" Click="OnMobileGoAuthorList"/>
                    <Button Content="🐾 Bộ tên" Classes="MobileNavItem" Click="OnMobileGoGlossary"/>
                    <Button Content="⚙ Cài đặt" Classes="MobileNavItem" Click="OnMobileGoSettings"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Vùng nội dung chính: thay cho Frame -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="ContentHost"/>
        </ScrollViewer>

        <!-- Lớp phủ modal dùng chung cho toàn app -->
        <Grid x:Name="ModalOverlay"
              Grid.RowSpan="2"
              Background="#66000000"
              IsVisible="False"
              ZIndex="1000"
              PointerPressed="OnModalOverlayClick">

            <ContentControl x:Name="ModalContent"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            PointerPressed="OnModalContentClick"/>
        </Grid>
    </Grid>
</UserControl>